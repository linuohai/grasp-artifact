# Check arguments
if [ "$SHOW_HELP" = true ] || [ $# -eq 0 ]; then
  show_usage
  exit 0
fi

# Scheduler option mutual-exclusion check
if [ "$NLEVEL_ENABLED" = true ] && [ "$GTO_ENABLED" = true ]; then
    echo "Error: -nl and -gto cannot be used together"
    echo ""
    show_usage
    exit 1
fi

PLOT_BACKEND="$(echo "$PLOT_BACKEND" | tr 'A-Z' 'a-z')"
if [ "$PLOT_BACKEND" != "session" ] && [ "$PLOT_BACKEND" != "local" ]; then
    echo "Error: --plot-backend only supports session|local (current: $PLOT_BACKEND)"
    exit 1
fi

NLEVEL_DEFAULT_SCHEDULER="$(echo "$NLEVEL_DEFAULT_SCHEDULER" | tr 'A-Z' 'a-z')"
if [ "$NLEVEL_DEFAULT_SCHEDULER" != "lrr" ] && [ "$NLEVEL_DEFAULT_SCHEDULER" != "gto" ]; then
    echo "Error: the n_level default scheduler only supports lrr or gto (current: $NLEVEL_DEFAULT_SCHEDULER)"
    exit 1
fi

PLOT_FORMAT="$(echo "$PLOT_FORMAT" | tr 'A-Z' 'a-z')"
if [ "$PLOT_FORMAT" != "svg" ] && [ "$PLOT_FORMAT" != "png" ] && [ "$PLOT_FORMAT" != "both" ]; then
    echo "Error: --plot-format only supports svg|png|both (current: $PLOT_FORMAT)"
    exit 1
fi

# Issue trace compression parameter check
ISSUE_TRACE_COMPRESS="$(echo "$ISSUE_TRACE_COMPRESS" | tr 'A-Z' 'a-z')"
if [ "$ISSUE_TRACE_COMPRESS" != "none" ] && [ "$ISSUE_TRACE_COMPRESS" != "gzip" ] && [ "$ISSUE_TRACE_COMPRESS" != "zstd" ]; then
    echo "Error: --issue-trace-compress only supports none|gzip|zstd (current: $ISSUE_TRACE_COMPRESS)"
    exit 1
fi
if [ -n "${ISSUE_TRACE_COMPRESS_LEVEL}" ]; then
    if ! [[ "${ISSUE_TRACE_COMPRESS_LEVEL}" =~ ^[0-9]+$ ]]; then
        echo "Error: --issue-trace-compress-level must be an integer (current: $ISSUE_TRACE_COMPRESS_LEVEL)"
        exit 1
    fi
fi
if [ -n "${ISSUE_TRACE_COMPRESS_THREADS}" ]; then
    if ! [[ "${ISSUE_TRACE_COMPRESS_THREADS}" =~ ^[0-9]+$ ]]; then
        echo "Error: --issue-trace-compress-threads must be an integer (current: $ISSUE_TRACE_COMPRESS_THREADS)"
        exit 1
    fi
fi

if [ -n "${STALL_REASON_PC_STATS_TOPK}" ]; then
    if ! [[ "${STALL_REASON_PC_STATS_TOPK}" =~ ^[0-9]+$ ]]; then
        echo "Error: --stall-reason-pc-stats-topk must be a non-negative integer (current: $STALL_REASON_PC_STATS_TOPK)"
        exit 1
    fi
fi

TRACE_KEY=$1

# Check whether the trace key exists
if [ -z "${TRACE_MAP[$TRACE_KEY]}" ]; then
    echo "Error: unknown trace key '$TRACE_KEY'"
    echo ""
    show_usage
    exit 1
fi

# Set the log file name (if a second argument is provided, use it as the log file name; otherwise use the trace key)
if [ $# -gt 1 ]; then
    LOG_NAME=$2
else
    LOG_NAME=$TRACE_KEY
fi
if [ "$NLEVEL_ENABLED" = true ]; then
    if [ "$NLEVEL_DEFAULT_SCHEDULER" = "gto" ]; then
        if [[ "$LOG_NAME" == *_nl_gto ]]; then
            :
        elif [[ "$LOG_NAME" == *_nl ]]; then
            LOG_NAME="${LOG_NAME}_gto"
        else
            LOG_NAME="${LOG_NAME}_nl_gto"
        fi
    else
        if [[ "$LOG_NAME" != *_nl ]]; then
            LOG_NAME="${LOG_NAME}_nl"
        fi
    fi
fi
if [ "$IDEAL_L1D_ENABLED" = true ] && [[ "$LOG_NAME" != *_ideal_l1d ]]; then
    LOG_NAME="${LOG_NAME}_ideal_l1d"
fi
if [ "$GTO_ENABLED" = true ] && [[ "$LOG_NAME" != *_gto ]]; then
    LOG_NAME="${LOG_NAME}_gto"
fi

# Build the full trace path
TRACE_PATH="$TRACE_BASE_DIR/${TRACE_MAP[$TRACE_KEY]}"

# Check whether the trace file exists
if [ ! -f "$TRACE_PATH" ]; then
    echo "Error: trace file does not exist: $TRACE_PATH"
    exit 1
fi

if [ "$NLEVEL_ENABLED" = true ]; then
    if [ "$NLEVEL_DEFAULT_SCHEDULER" = "gto" ]; then
        NLEVEL_WARP_ALLOC_REL="${NLEVEL_WARP_ALLOC_MAP[${TRACE_KEY}gto]}"
        if [ -z "$NLEVEL_WARP_ALLOC_REL" ]; then
            echo "Error: no n_level gto warp alloc file configured for trace_key=$TRACE_KEY"
            echo "Please add the ${TRACE_KEY}gto mapping to NLEVEL_WARP_ALLOC_MAP in the script, or use --nlevel-scheduler lrr instead"
            exit 1
        fi
    else
        NLEVEL_WARP_ALLOC_REL="${NLEVEL_WARP_ALLOC_MAP[$TRACE_KEY]}"
        if [ -z "$NLEVEL_WARP_ALLOC_REL" ]; then
            echo "Error: no n_level warp alloc file configured for trace_key=$TRACE_KEY"
            echo "Please add the mapping to NLEVEL_WARP_ALLOC_MAP in the script"
            exit 1
        fi
    fi
    NLEVEL_WARP_ALLOC_FILE="$BASE_DIR/$NLEVEL_WARP_ALLOC_REL"
    if [ ! -f "$NLEVEL_WARP_ALLOC_FILE" ]; then
        echo "Error: n_level warp alloc file does not exist: $NLEVEL_WARP_ALLOC_FILE"
        exit 1
    fi
fi

# Set output file names
LOG_FILE="$RESULT_LOG_DIR/${LOG_NAME}.log"
CSV_FILE="$RESULT_L1_DIR/${LOG_NAME}_l1.csv"
L2_CSV_FILE="$RESULT_L2_DIR/${LOG_NAME}_l2.csv"
ISSUE_FILE_RAW="$RESULT_ISSUE_DIR/${LOG_NAME}_issue.csv"
ISSUE_FILE_GZ="$RESULT_ISSUE_DIR/${LOG_NAME}_issue.csv.gz"
ISSUE_FILE_ZST="$RESULT_ISSUE_DIR/${LOG_NAME}_issue.csv.zst"
ISSUE_FIFO_REL="result/issue_trace/${LOG_NAME}_issue.csv.fifo"
ISSUE_FIFO_ABS="$BASE_DIR/$ISSUE_FIFO_REL"
ISSUE_COMPRESS_LOG="$RESULT_LOG_DIR/${LOG_NAME}_issue_trace_compress.log"
ISSUE_FILE="$ISSUE_FILE_RAW"
BANDWIDTH_FILE="$RESULT_BW_DIR/${LOG_NAME}_hbm_partition.csv"
ICNT_BW_FILE="$RESULT_ICNT_BW_DIR/${LOG_NAME}_icnt_bw.csv"
L2_BW_FILE="$RESULT_L2_BW_DIR/${LOG_NAME}_l2_bw.csv"

# Per-run stall reason/pc stats output directory (avoids overwriting across concurrent/multiple algorithm runs)
RESULT_STALL_REASON_PC_STATS_DIR="$RESULT_STALL_REASON_PC_STATS_BASE_DIR/$LOG_NAME"
mkdir -p "$RESULT_STALL_REASON_PC_STATS_DIR"
mkdir -p "$RESULT_GRASP_TRACE_DIR"

REL_L1_FILE="result/L1cache_trace/${LOG_NAME}_l1.csv"
REL_L2_FILE="result/L2cache_trace/${LOG_NAME}_l2.csv"
REL_ISSUE_FILE="result/issue_trace/${LOG_NAME}_issue.csv"
REL_STALL_REASON_PC_STATS_DIR="result/issue_trace/stall_reason_pc_stats/${LOG_NAME}"
REL_BW_FILE="result/bandwidth/${LOG_NAME}_hbm_partition.csv"
REL_ICNT_BW_FILE="result/icnt_bw/${LOG_NAME}_icnt_bw.csv"
REL_L2_BW_FILE="result/l2_bw/${LOG_NAME}_l2_bw.csv"
REL_GRASP_TRACE_FILE="result/grasp_trace/${LOG_NAME}_grasp.csv"

STALL_REASON_PC_STATS_BREAKDOWN="$RESULT_STALL_REASON_PC_STATS_DIR/stall_reason_breakdown.csv"
STALL_REASON_PC_STATS_HIST="$RESULT_STALL_REASON_PC_STATS_DIR/stall_reason_pc_hist.csv"
STALL_REASON_PC_STATS_TOPK_FILE="$RESULT_STALL_REASON_PC_STATS_DIR/stall_reason_pc_topk_other.csv"

# For easier identification in the IDE: rename the stats CSVs to filenames prefixed with the log name (keep only the prefixed version)
STALL_REASON_PC_STATS_BREAKDOWN_PREFIXED="$RESULT_STALL_REASON_PC_STATS_DIR/${LOG_NAME}_stall_reason_breakdown.csv"
STALL_REASON_PC_STATS_HIST_PREFIXED="$RESULT_STALL_REASON_PC_STATS_DIR/${LOG_NAME}_stall_reason_pc_hist.csv"
STALL_REASON_PC_STATS_TOPK_PREFIXED="$RESULT_STALL_REASON_PC_STATS_DIR/${LOG_NAME}_stall_reason_pc_topk_other.csv"

# Create a temporary config file and update the L1 trace path
TEMP_GPGPU_CONFIG=$(mktemp)
ISSUE_TRACE_COMPRESS_PID=""
ISSUE_TRACE_KEEPFD=""
cleanup() {
    # Close the persistent FIFO writer fd (if present), so the compressor receives EOF and exits
    if [ -n "${ISSUE_TRACE_KEEPFD:-}" ]; then
        exec {ISSUE_TRACE_KEEPFD}>&- 2>/dev/null || true
        ISSUE_TRACE_KEEPFD=""
    fi
    # If the compressor is still running, wait for it to exit if possible; if it still hasn't exited, try to terminate it
    if [ -n "${ISSUE_TRACE_COMPRESS_PID:-}" ]; then
        if kill -0 "$ISSUE_TRACE_COMPRESS_PID" 2>/dev/null; then
            wait "$ISSUE_TRACE_COMPRESS_PID" 2>/dev/null || true
        fi
        ISSUE_TRACE_COMPRESS_PID=""
    fi
    # Clean up the FIFO
    if [ -n "${ISSUE_FIFO_ABS:-}" ] && [ -p "${ISSUE_FIFO_ABS}" ]; then
        rm -f "$ISSUE_FIFO_ABS" 2>/dev/null || true
    fi
    rm -f "$TEMP_GPGPU_CONFIG" 2>/dev/null || true
}
trap cleanup EXIT

# If issue trace streaming compression is enabled: point -issue_trace_path at the FIFO, and switch the final output path to the compressed file
ISSUE_TRACE_COMPRESS_EFFECTIVE="$ISSUE_TRACE_COMPRESS"
if [ "$ISSUE_TRACE_ENABLED" != true ]; then
    ISSUE_TRACE_COMPRESS_EFFECTIVE="none"
fi
if [ "$ISSUE_TRACE_COMPRESS_EFFECTIVE" = "gzip" ]; then
    REL_ISSUE_FILE="$ISSUE_FIFO_REL"
    ISSUE_FILE="$ISSUE_FILE_GZ"
elif [ "$ISSUE_TRACE_COMPRESS_EFFECTIVE" = "zstd" ]; then
    REL_ISSUE_FILE="$ISSUE_FIFO_REL"
    ISSUE_FILE="$ISSUE_FILE_ZST"
fi

# Copy the original config file and update the trace output paths (icnt/l2_bw are written/enabled by the subsequent toggle blocks)
sed -e "s|-l1_trace_path .*|-l1_trace_path \"$REL_L1_FILE\"|g" \
    -e "s|-l2_trace_path .*|-l2_trace_path \"$REL_L2_FILE\"|g" \
    -e "s|-issue_trace_path .*|-issue_trace_path \"$REL_ISSUE_FILE\"|g" \
    -e "s|-hbm_partition_trace_path .*|-hbm_partition_trace_path \"$REL_BW_FILE\"|g" \
    -e "s|-hbm_partition_trace_enable .*|-hbm_partition_trace_enable 1|g" \
    -e "s|-hbm_partition_trace_period .*|-hbm_partition_trace_period 1|g" \
    "$GPGPU_CONFIG" > "$TEMP_GPGPU_CONFIG"

# If the original config lacks L2 trace-related entries, fill them in (keeping the same "script controls the output path" behavior as L1/issue)
if ! grep -q '^-l2_trace_enable[[:space:]]' "$TEMP_GPGPU_CONFIG"; then
    echo "-l2_trace_enable 1" >> "$TEMP_GPGPU_CONFIG"
fi
if ! grep -q '^-l2_trace_path[[:space:]]' "$TEMP_GPGPU_CONFIG"; then
    echo "-l2_trace_path \"$REL_L2_FILE\"" >> "$TEMP_GPGPU_CONFIG"
fi
if [ "$L2_TRACE_PRINT_BW" = true ]; then
    if grep -q '^-l2_trace_print_bw[[:space:]]' "$TEMP_GPGPU_CONFIG"; then
        sed -i "s|^-l2_trace_print_bw[[:space:]].*|-l2_trace_print_bw 1|g" "$TEMP_GPGPU_CONFIG"
    else
        echo "-l2_trace_print_bw 1" >> "$TEMP_GPGPU_CONFIG"
    fi
fi
if [ "$L2_TRACE_PRINT_COMPUTE" = true ]; then
    if grep -q '^-l2_trace_print_compute[[:space:]]' "$TEMP_GPGPU_CONFIG"; then
        sed -i "s|^-l2_trace_print_compute[[:space:]].*|-l2_trace_print_compute 1|g" "$TEMP_GPGPU_CONFIG"
    else
        echo "-l2_trace_print_compute 1" >> "$TEMP_GPGPU_CONFIG"
    fi
fi
if [ "$HBM_TRACE_ENABLED" = true ]; then
    if ! grep -q '^-hbm_partition_trace_enable[[:space:]]' "$TEMP_GPGPU_CONFIG"; then
        echo "-hbm_partition_trace_enable 1" >> "$TEMP_GPGPU_CONFIG"
    else
        sed -i "s|^-hbm_partition_trace_enable[[:space:]].*|-hbm_partition_trace_enable 1|g" "$TEMP_GPGPU_CONFIG"
    fi
    if ! grep -q '^-hbm_partition_trace_path[[:space:]]' "$TEMP_GPGPU_CONFIG"; then
        echo "-hbm_partition_trace_path \"$REL_BW_FILE\"" >> "$TEMP_GPGPU_CONFIG"
    fi
    if ! grep -q '^-hbm_partition_trace_period[[:space:]]' "$TEMP_GPGPU_CONFIG"; then
        echo "-hbm_partition_trace_period $HBM_TRACE_PERIOD" >> "$TEMP_GPGPU_CONFIG"
    else
        sed -i "s|^-hbm_partition_trace_period[[:space:]].*|-hbm_partition_trace_period $HBM_TRACE_PERIOD|g" "$TEMP_GPGPU_CONFIG"
    fi
else
    if grep -q '^-hbm_partition_trace_enable[[:space:]]' "$TEMP_GPGPU_CONFIG"; then
        sed -i "s|^-hbm_partition_trace_enable[[:space:]].*|-hbm_partition_trace_enable 0|g" "$TEMP_GPGPU_CONFIG"
    else
        echo "-hbm_partition_trace_enable 0" >> "$TEMP_GPGPU_CONFIG"
    fi
fi

# ICNT BW trace
if [ "$ICNT_BW_TRACE_ENABLED" = true ]; then
    if ! grep -q '^-icnt_trace_enable[[:space:]]' "$TEMP_GPGPU_CONFIG"; then
        echo "-icnt_trace_enable 1" >> "$TEMP_GPGPU_CONFIG"
    else
        sed -i "s|^-icnt_trace_enable[[:space:]].*|-icnt_trace_enable 1|g" "$TEMP_GPGPU_CONFIG"
    fi
    if ! grep -q '^-icnt_trace_path[[:space:]]' "$TEMP_GPGPU_CONFIG"; then
        echo "-icnt_trace_path \"$REL_ICNT_BW_FILE\"" >> "$TEMP_GPGPU_CONFIG"
    fi
    if ! grep -q '^-icnt_trace_period[[:space:]]' "$TEMP_GPGPU_CONFIG"; then
        echo "-icnt_trace_period $ICNT_BW_TRACE_PERIOD" >> "$TEMP_GPGPU_CONFIG"
    else
        sed -i "s|^-icnt_trace_period[[:space:]].*|-icnt_trace_period $ICNT_BW_TRACE_PERIOD|g" "$TEMP_GPGPU_CONFIG"
    fi
else
    if grep -q '^-icnt_trace_enable[[:space:]]' "$TEMP_GPGPU_CONFIG"; then
        sed -i "s|^-icnt_trace_enable[[:space:]].*|-icnt_trace_enable 0|g" "$TEMP_GPGPU_CONFIG"
    else
        echo "-icnt_trace_enable 0" >> "$TEMP_GPGPU_CONFIG"
    fi
fi

# L2 BW trace
if [ "$L2_BW_TRACE_ENABLED" = true ]; then
    if ! grep -q '^-l2_bw_enable[[:space:]]' "$TEMP_GPGPU_CONFIG"; then
        echo "-l2_bw_enable 1" >> "$TEMP_GPGPU_CONFIG"
    else
        sed -i "s|^-l2_bw_enable[[:space:]].*|-l2_bw_enable 1|g" "$TEMP_GPGPU_CONFIG"
    fi
    if ! grep -q '^-l2_bw_path[[:space:]]' "$TEMP_GPGPU_CONFIG"; then
        echo "-l2_bw_path \"$REL_L2_BW_FILE\"" >> "$TEMP_GPGPU_CONFIG"
    fi
    if ! grep -q '^-l2_bw_period[[:space:]]' "$TEMP_GPGPU_CONFIG"; then
        echo "-l2_bw_period $L2_BW_TRACE_PERIOD" >> "$TEMP_GPGPU_CONFIG"
    else
        sed -i "s|^-l2_bw_period[[:space:]].*|-l2_bw_period $L2_BW_TRACE_PERIOD|g" "$TEMP_GPGPU_CONFIG"
    fi
else
    if grep -q '^-l2_bw_enable[[:space:]]' "$TEMP_GPGPU_CONFIG"; then
        sed -i "s|^-l2_bw_enable[[:space:]].*|-l2_bw_enable 0|g" "$TEMP_GPGPU_CONFIG"
    else
        echo "-l2_bw_enable 0" >> "$TEMP_GPGPU_CONFIG"
    fi
fi

# Ideal L1D: force eligible global reads to L1D HIT (timing upper bound).
if [ "$IDEAL_L1D_ENABLED" = true ]; then
    if grep -q '^[[:space:]]*-gpgpu_perfect_l1d[[:space:]]' "$TEMP_GPGPU_CONFIG"; then
        sed -i "s|^[[:space:]]*-gpgpu_perfect_l1d[[:space:]].*|-gpgpu_perfect_l1d 1|g" "$TEMP_GPGPU_CONFIG"
    else
        echo "-gpgpu_perfect_l1d 1" >> "$TEMP_GPGPU_CONFIG"
    fi
else
    if grep -q '^[[:space:]]*-gpgpu_perfect_l1d[[:space:]]' "$TEMP_GPGPU_CONFIG"; then
        sed -i "s|^[[:space:]]*-gpgpu_perfect_l1d[[:space:]].*|-gpgpu_perfect_l1d 0|g" "$TEMP_GPGPU_CONFIG"
    else
        echo "-gpgpu_perfect_l1d 0" >> "$TEMP_GPGPU_CONFIG"
    fi
fi

# GRASP prefetcher: enable and configure
if [ "$GRASP_ENABLED" = true ]; then
    echo "-grasp_enable 1" >> "$TEMP_GPGPU_CONFIG"
    # Default chain CSV: strict_selected_chain_instances.csv (covers BFS/SSSP/BC/SpMV)
    if [ -z "$GRASP_CHAIN_CSV" ]; then
        GRASP_CHAIN_CSV="$BASE_DIR/data/golden_chains/strict_selected_chain_instances.csv"
    fi
    if [ ! -f "$GRASP_CHAIN_CSV" ]; then
        echo "Warning: GRASP chain CSV does not exist: $GRASP_CHAIN_CSV"
        echo "  The GRASP pair table will be empty; only CD/CT/stride training takes effect"
    fi
    echo "-gpgpu_ima_prefetch_chain_csv \"$GRASP_CHAIN_CSV\"" >> "$TEMP_GPGPU_CONFIG"
    if [ "$GRASP_DEBUG" = true ]; then
        echo "-grasp_debug 1" >> "$TEMP_GPGPU_CONFIG"
    fi
    if [ "$GRASP_TRACE_ENABLED" = true ]; then
        echo "-grasp_trace_enable 1" >> "$TEMP_GPGPU_CONFIG"
        echo "-grasp_trace_path \"$REL_GRASP_TRACE_FILE\"" >> "$TEMP_GPGPU_CONFIG"
    fi
    if [ "$GRASP_DISTANCE" -gt 0 ] 2>/dev/null; then
        echo "-grasp_ist_distance $GRASP_DISTANCE" >> "$TEMP_GPGPU_CONFIG"
    fi
    if [ "$GRASP_SPECULATIVE_STRIDE" -gt 0 ] 2>/dev/null; then
        echo "-grasp_speculative_stride $GRASP_SPECULATIVE_STRIDE" >> "$TEMP_GPGPU_CONFIG"
    fi
    if [ -n "$PAIR_TABLE_SCOPE" ]; then
        case "$PAIR_TABLE_SCOPE" in
            warp|0)   echo "-grasp_pair_table_scope 0" >> "$TEMP_GPGPU_CONFIG" ;;
            cta|1)    echo "-grasp_pair_table_scope 1" >> "$TEMP_GPGPU_CONFIG" ;;
            kernel|2) echo "-grasp_pair_table_scope 2" >> "$TEMP_GPGPU_CONFIG" ;;
            *) echo "ERROR: --pair-table-scope must be warp/cta/kernel (or 0/1/2)"; exit 1 ;;
        esac
    fi
    # Pair table CSV dump: auto-enable when --grasp-debug or --grasp-trace
    if [ "$GRASP_DEBUG" = true ] || [ "$GRASP_TRACE_ENABLED" = true ]; then
        echo "-grasp_pair_table_dump_path \"result/grasp_trace/${LOG_NAME}_pair_table.csv\"" >> "$TEMP_GPGPU_CONFIG"
    fi
fi

# IMA demand tracking: load the chain CSV to identify IMA PCs even when GRASP is not enabled (used for IMA_DEMAND statistics)
if [ "$GRASP_ENABLED" != true ]; then
    IMA_CHAIN_CSV="${GRASP_CHAIN_CSV:-$BASE_DIR/data/golden_chains/strict_selected_chain_instances.csv}"
    if [ -f "$IMA_CHAIN_CSV" ]; then
        echo "-gpgpu_ima_prefetch_chain_csv \"$IMA_CHAIN_CSV\"" >> "$TEMP_GPGPU_CONFIG"
    fi
fi

# Extra simulation arguments (--sim-args): appended raw to gpgpusim config
if [ -n "$EXTRA_SIM_ARGS" ]; then
    echo "$EXTRA_SIM_ARGS" >> "$TEMP_GPGPU_CONFIG"
fi

# trace enable toggles (default matches the original config; overridable here from the command line)
if [ "$ISSUE_TRACE_ENABLED" = true ]; then
    sed -i "s|^-issue_trace_enable[[:space:]].*|-issue_trace_enable 1|g" "$TEMP_GPGPU_CONFIG" || true
else
    if grep -q '^-issue_trace_enable[[:space:]]' "$TEMP_GPGPU_CONFIG"; then
        sed -i "s|^-issue_trace_enable[[:space:]].*|-issue_trace_enable 0|g" "$TEMP_GPGPU_CONFIG"
    else
        echo "-issue_trace_enable 0" >> "$TEMP_GPGPU_CONFIG"
    fi
    if grep -q '^-issue_trace_path[[:space:]]' "$TEMP_GPGPU_CONFIG"; then
        sed -i "s|^-issue_trace_path[[:space:]].*|-issue_trace_path \"\"|g" "$TEMP_GPGPU_CONFIG"
    fi
fi

# Lightweight stall reason / pc statistics (output uses fixed filenames, in a subdirectory under issue_trace)
if [ "$STALL_REASON_PC_STATS_ENABLED" = true ]; then
    if grep -q '^-stall_reason_pc_stats_enable[[:space:]]' "$TEMP_GPGPU_CONFIG"; then
        sed -i "s|^-stall_reason_pc_stats_enable[[:space:]].*|-stall_reason_pc_stats_enable 1|g" "$TEMP_GPGPU_CONFIG"
    else
        echo "-stall_reason_pc_stats_enable 1" >> "$TEMP_GPGPU_CONFIG"
    fi
    if grep -q '^-stall_reason_pc_stats_path[[:space:]]' "$TEMP_GPGPU_CONFIG"; then
        sed -i "s|^-stall_reason_pc_stats_path[[:space:]].*|-stall_reason_pc_stats_path \"$REL_STALL_REASON_PC_STATS_DIR\"|g" "$TEMP_GPGPU_CONFIG"
    else
        echo "-stall_reason_pc_stats_path \"$REL_STALL_REASON_PC_STATS_DIR\"" >> "$TEMP_GPGPU_CONFIG"
    fi
    if grep -q '^-stall_reason_pc_stats_topk[[:space:]]' "$TEMP_GPGPU_CONFIG"; then
        sed -i "s|^-stall_reason_pc_stats_topk[[:space:]].*|-stall_reason_pc_stats_topk $STALL_REASON_PC_STATS_TOPK|g" "$TEMP_GPGPU_CONFIG"
    else
        echo "-stall_reason_pc_stats_topk $STALL_REASON_PC_STATS_TOPK" >> "$TEMP_GPGPU_CONFIG"
    fi
else
    if grep -q '^-stall_reason_pc_stats_enable[[:space:]]' "$TEMP_GPGPU_CONFIG"; then
        sed -i "s|^-stall_reason_pc_stats_enable[[:space:]].*|-stall_reason_pc_stats_enable 0|g" "$TEMP_GPGPU_CONFIG"
    else
        echo "-stall_reason_pc_stats_enable 0" >> "$TEMP_GPGPU_CONFIG"
    fi
fi

if [ "$L1_TRACE_ENABLED" = true ]; then
    sed -i "s|^-l1_trace_enable[[:space:]].*|-l1_trace_enable 1|g" "$TEMP_GPGPU_CONFIG" || true
else
    if grep -q '^-l1_trace_enable[[:space:]]' "$TEMP_GPGPU_CONFIG"; then
        sed -i "s|^-l1_trace_enable[[:space:]].*|-l1_trace_enable 0|g" "$TEMP_GPGPU_CONFIG"
    else
        echo "-l1_trace_enable 0" >> "$TEMP_GPGPU_CONFIG"
    fi
fi
if [ "$L2_TRACE_ENABLED" = true ]; then
    sed -i "s|^-l2_trace_enable[[:space:]].*|-l2_trace_enable 1|g" "$TEMP_GPGPU_CONFIG" || true
else
    if grep -q '^-l2_trace_enable[[:space:]]' "$TEMP_GPGPU_CONFIG"; then
        sed -i "s|^-l2_trace_enable[[:space:]].*|-l2_trace_enable 0|g" "$TEMP_GPGPU_CONFIG"
    else
        echo "-l2_trace_enable 0" >> "$TEMP_GPGPU_CONFIG"
    fi
fi

# Early termination (reduces simulation/output volume; 0 means unlimited)
if [ "${MAX_CYCLE:-0}" != "0" ] || [ "${MAX_INSN:-0}" != "0" ] || [ "${MAX_CTA:-0}" != "0" ] || [ "${MAX_COMPLETED_CTA:-0}" != "0" ]; then
    sed -i "/^[[:space:]]*-gpgpu_max_cycle[[:space:]]/d" "$TEMP_GPGPU_CONFIG"
    sed -i "/^[[:space:]]*-gpgpu_max_insn[[:space:]]/d" "$TEMP_GPGPU_CONFIG"
    sed -i "/^[[:space:]]*-gpgpu_max_cta[[:space:]]/d" "$TEMP_GPGPU_CONFIG"
    sed -i "/^[[:space:]]*-gpgpu_max_completed_cta[[:space:]]/d" "$TEMP_GPGPU_CONFIG"
    {
        echo "-gpgpu_max_cycle $MAX_CYCLE"
        echo "-gpgpu_max_insn $MAX_INSN"
        echo "-gpgpu_max_cta $MAX_CTA"
        echo "-gpgpu_max_completed_cta $MAX_COMPLETED_CTA"
    } >> "$TEMP_GPGPU_CONFIG"
fi

if [ "$NLEVEL_ENABLED" = true ]; then
    sed -i "/^[[:space:]]*-gpgpu_scheduler[[:space:]]/d" "$TEMP_GPGPU_CONFIG"
    sed -i "/^[[:space:]]*-gpgpu_n_level_warp_alloc_file[[:space:]]/d" "$TEMP_GPGPU_CONFIG"
    sed -i "/^[[:space:]]*-gpgpu_n_level_default_scheduler[[:space:]]/d" "$TEMP_GPGPU_CONFIG"
    {
        echo "-gpgpu_scheduler n_level"
        echo "-gpgpu_n_level_warp_alloc_file \"$NLEVEL_WARP_ALLOC_FILE\""
        echo "-gpgpu_n_level_default_scheduler $NLEVEL_DEFAULT_SCHEDULER"
    } >> "$TEMP_GPGPU_CONFIG"
fi

if [ "$GTO_ENABLED" = true ]; then
    sed -i "/^[[:space:]]*-gpgpu_scheduler[[:space:]]/d" "$TEMP_GPGPU_CONFIG"
    sed -i "/^[[:space:]]*-gpgpu_n_level_warp_alloc_file[[:space:]]/d" "$TEMP_GPGPU_CONFIG"
    sed -i "/^[[:space:]]*-gpgpu_n_level_default_scheduler[[:space:]]/d" "$TEMP_GPGPU_CONFIG"
    {
        echo "-gpgpu_scheduler gto"
    } >> "$TEMP_GPGPU_CONFIG"
fi

# Debug info: show the updated trace output paths
echo "The L1 trace path in the config file has been updated to: $CSV_FILE"
echo "The HBM partition bandwidth trace path in the config file has been updated to: $BANDWIDTH_FILE"
if [ "$ICNT_BW_TRACE_ENABLED" = true ]; then
    echo "The ICNT bandwidth trace path in the config file has been updated to: $ICNT_BW_FILE"
fi
if [ "$L2_BW_TRACE_ENABLED" = true ]; then
    echo "The L2 bandwidth trace path in the config file has been updated to: $L2_BW_FILE"
fi
if [ "$NLEVEL_ENABLED" = true ]; then
    echo "n_level scheduler enabled: $NLEVEL_WARP_ALLOC_FILE (default=$NLEVEL_DEFAULT_SCHEDULER)"
fi
if [ "$GTO_ENABLED" = true ]; then
    echo "gto scheduler enabled"
fi

# Show run information
echo "=========================================="
echo "Running the Accel-Sim simulator"
echo "=========================================="
echo "Config model: $CONFIG_MODEL"
echo "Trace key: $TRACE_KEY"
echo "Trace path: $TRACE_PATH"
echo "Log file name: $LOG_NAME"
echo "Log file: $LOG_FILE"
echo "CSV file: $CSV_FILE"
echo "L2 CSV file: $L2_CSV_FILE"
if [ "$ISSUE_TRACE_ENABLED" = true ]; then
    echo "Issue CSV file: $ISSUE_FILE"
else
    echo "Issue CSV file: (disabled)"
fi
if [ "$STALL_REASON_PC_STATS_ENABLED" = true ]; then
    echo "Stall reason/PC stats dir: $RESULT_STALL_REASON_PC_STATS_DIR"
fi
echo "HBM partition bandwidth CSV file: $BANDWIDTH_FILE"
if [ "$ICNT_BW_TRACE_ENABLED" = true ]; then
    echo "ICNT bandwidth CSV file: $ICNT_BW_FILE"
fi
if [ "$L2_BW_TRACE_ENABLED" = true ]; then
    echo "L2 bandwidth CSV file: $L2_BW_FILE"
fi
if [ "$ISSUE_TRACE_COMPRESS_EFFECTIVE" != "none" ]; then
    echo "Issue trace compression: $ISSUE_TRACE_COMPRESS_EFFECTIVE (level=${ISSUE_TRACE_COMPRESS_LEVEL:-default}, threads=${ISSUE_TRACE_COMPRESS_THREADS})"
    echo "Issue trace compression log: $ISSUE_COMPRESS_LOG"
fi
if [ "$NLEVEL_ENABLED" = true ]; then
    echo "n_level warp alloc: $NLEVEL_WARP_ALLOC_FILE"
    echo "n_level default scheduler: $NLEVEL_DEFAULT_SCHEDULER"
fi
if [ "$GTO_ENABLED" = true ]; then
    echo "scheduler: gto"
fi
if [ "$GRASP_ENABLED" = true ]; then
    echo "GRASP prefetcher: enabled"
    echo "  Chain CSV: ${GRASP_CHAIN_CSV:-$BASE_DIR/data/golden_chains/strict_selected_chain_instances.csv}"
    echo "  IST Distance: ${GRASP_DISTANCE:-1 (default)}"
    echo "  (other parameters use default values; see the GRASP_CONFIG line in the log)"
else
    echo "GRASP prefetcher: disabled"
fi
echo "=========================================="

# Start issue trace streaming compression (must complete before accel-sim starts, otherwise issue_tracer opening the FIFO will block)
if [ "$ISSUE_TRACE_COMPRESS_EFFECTIVE" != "none" ]; then
    if [ "$ISSUE_TRACE_COMPRESS_EFFECTIVE" = "zstd" ] && ! command -v zstd >/dev/null 2>&1; then
        echo "Error: zstd compression was selected but the zstd command was not found on the system. Please install zstd or use --issue-trace-compress gzip instead"
        exit 1
    fi

    rm -f "$ISSUE_FIFO_ABS" 2>/dev/null || true
    mkfifo "$ISSUE_FIFO_ABS"

    rm -f "$ISSUE_FILE" 2>/dev/null || true
    rm -f "$ISSUE_COMPRESS_LOG" 2>/dev/null || true

    if [ "$ISSUE_TRACE_COMPRESS_EFFECTIVE" = "gzip" ]; then
        level="${ISSUE_TRACE_COMPRESS_LEVEL:-1}"
        (
            gzip -"${level}" -c < "$ISSUE_FIFO_ABS" > "$ISSUE_FILE"
        ) 2> "$ISSUE_COMPRESS_LOG" &
        ISSUE_TRACE_COMPRESS_PID=$!
    else
        level="${ISSUE_TRACE_COMPRESS_LEVEL:-3}"
        threads="${ISSUE_TRACE_COMPRESS_THREADS:-1}"
        (
            zstd -T"${threads}" -"${level}" -c < "$ISSUE_FIFO_ABS" > "$ISSUE_FILE"
        ) 2> "$ISSUE_COMPRESS_LOG" &
        ISSUE_TRACE_COMPRESS_PID=$!
    fi

    # Persistent writer fd: prevents issue_tracer's per-flush open/close from causing the compressor to see EOF and exit early
    exec {ISSUE_TRACE_KEEPFD}> "$ISSUE_FIFO_ABS"
fi

# Make sure LD_LIBRARY_PATH and other environment variables are set (otherwise the system libcudart may be loaded by mistake, causing missing symbols)
if [ -z "${ACCELSIM_SETUP_ENVIRONMENT_WAS_RUN:-}" ]; then
    # shellcheck disable=SC1091
    source "$BASE_DIR/gpu-simulator/setup_environment.sh" release || {
        echo "Error: setup_environment.sh failed. Please run the following manually in the current shell first:"
        echo "  source gpu-simulator/setup_environment.sh release"
        exit 1
    }
fi

# Run the simulator
(
    cd "$BASE_DIR" || exit 1
    "$ACCEL_SIM_BIN" \
    -trace "$TRACE_PATH" \
    -config "$TRACE_CONFIG" \
    -config "$TEMP_GPGPU_CONFIG"
) |& tee "$LOG_FILE"

# Check the run result
if [ ${PIPESTATUS[0]} -eq 0 ]; then
    # Finish issue trace compression: close the persistent writer fd and wait for the compressor to exit, to ensure the compressed file is complete
    if [ "$ISSUE_TRACE_COMPRESS_EFFECTIVE" != "none" ]; then
        exec {ISSUE_TRACE_KEEPFD}>&- 2>/dev/null || true
        ISSUE_TRACE_KEEPFD=""
        if [ -n "${ISSUE_TRACE_COMPRESS_PID:-}" ]; then
            if ! wait "$ISSUE_TRACE_COMPRESS_PID"; then
                echo "[warn] issue trace compression process exited abnormally (partial output can still be checked): pid=$ISSUE_TRACE_COMPRESS_PID"
                echo "[warn] compression log: $ISSUE_COMPRESS_LOG"
            fi
            ISSUE_TRACE_COMPRESS_PID=""
        fi
        rm -f "$ISSUE_FIFO_ABS" 2>/dev/null || true
    fi

    # Lightweight stall stats: after the simulation ends, rename the fixed filenames to prefixed filenames (avoids identically-named files being hard to distinguish in an IDE)
    if [ "$STALL_REASON_PC_STATS_ENABLED" = true ]; then
        if [ -f "$STALL_REASON_PC_STATS_BREAKDOWN" ]; then
            mv -f "$STALL_REASON_PC_STATS_BREAKDOWN" "$STALL_REASON_PC_STATS_BREAKDOWN_PREFIXED"
        fi
        if [ -f "$STALL_REASON_PC_STATS_HIST" ]; then
            mv -f "$STALL_REASON_PC_STATS_HIST" "$STALL_REASON_PC_STATS_HIST_PREFIXED"
        fi
        if [ "${STALL_REASON_PC_STATS_TOPK:-0}" != "0" ] && [ -f "$STALL_REASON_PC_STATS_TOPK_FILE" ]; then
            mv -f "$STALL_REASON_PC_STATS_TOPK_FILE" "$STALL_REASON_PC_STATS_TOPK_PREFIXED"
        fi

        # Update the variables so subsequent printing/plotting use the prefixed paths
        STALL_REASON_PC_STATS_BREAKDOWN="$STALL_REASON_PC_STATS_BREAKDOWN_PREFIXED"
        STALL_REASON_PC_STATS_HIST="$STALL_REASON_PC_STATS_HIST_PREFIXED"
        STALL_REASON_PC_STATS_TOPK_FILE="$STALL_REASON_PC_STATS_TOPK_PREFIXED"
    fi

    # ── Experiment completeness verification ──────────────────────────────────────────────
    verify_completion() {
        local log_file="$1"
        local trace_path="$2"

        # 1. Check the exit flag
        local exit_ok=false
        if grep -q "exit detected" "$log_file"; then
            exit_ok=true
        fi

        # 2. Count the number of completed kernels (gpu_tot_ipc appears once each time a kernel finishes)
        local completed_kernels
        completed_kernels=$(grep -c "gpu_tot_ipc" "$log_file" 2>/dev/null || echo 0)

        # 3. Count the expected number of kernels from the trace directory
        local trace_dir
        trace_dir=$(dirname "$trace_path")
        local expected_kernels
        expected_kernels=$(find "$trace_dir" -maxdepth 1 -name 'kernel-*.traceg*' 2>/dev/null | wc -l)

        # 4. Extract the final IPC and cycles
        local final_ipc final_cycles
        final_ipc=$(grep "gpu_tot_ipc" "$log_file" | tail -1 | awk '{print $NF}')
        final_cycles=$(grep "gpu_tot_sim_cycle" "$log_file" | tail -1 | awk -F'=' '{print $2}' | tr -d ' ')

        # 5. Determine the status
        local status
        if [ "$exit_ok" = true ] && [ "$completed_kernels" -eq "$expected_kernels" ] 2>/dev/null; then
            status="COMPLETE"
        elif [ "$exit_ok" = true ]; then
            status="PARTIAL (${completed_kernels}/${expected_kernels} kernels)"
        else
            status="CRASHED"
        fi

        # 6. Extract IMA demand statistics (present in both baseline and GRASP)
        local ima_demand_line grasp_ima_misses="" ima_timeliness_line=""
        ima_demand_line=$(grep "^IMA_DEMAND:" "$log_file" | tail -1)
        ima_timeliness_line=$(grep "^IMA_TIMELINESS:" "$log_file" | tail -1)
        if [ -n "$ima_demand_line" ]; then
            grasp_ima_misses=$(echo "$ima_demand_line" | grep -oP 'data_misses=\K[0-9]+')
        fi

        # 7. Extract GRASP metrics (aggregated across all SMs, GRASP mode only)
        local grasp_effect="" grasp_storage="" grasp_rfail="" grasp_funnel="" coverage_str=""
        if [ "$GRASP_ENABLED" = true ]; then
            # GRASP_EFFECT: cumulative counter -> take the last value per SM, sum across all SMs
            grasp_effect=$(grep "^GRASP_EFFECT SM" "$log_file" | awk '{
                split($2,a,":"); gsub(/SM/,"",a[1]); sm=a[1]
                for(i=3;i<=NF;i++){split($i,kv,"=")
                    if(kv[1]=="pf_useful")useful[sm]=kv[2]+0
                    if(kv[1]=="pf_useless")useless[sm]=kv[2]+0
                    if(kv[1]=="pf_late")late[sm]=kv[2]+0}
            } END {tu=0;ts=0;tl=0
                for(s in useful){tu+=useful[s];ts+=useless[s];tl+=late[s]}
                printf "pf_useful=%d pf_useless=%d pf_late=%d",tu,ts,tl
                if(tu+ts>0)printf " accuracy=%.2f%%",100.0*tu/(tu+ts)}')

            # GRASP_STORAGE: take the maximum of the peak values across SMs
            grasp_storage=$(grep "^GRASP_STORAGE SM" "$log_file" | awk '{
                for(i=3;i<=NF;i++){
                    if($i~/^prb=/){split($i,a,"/");gsub(/prb=/,"",a[1]);split(a[2],b,"(")
                        if(a[1]+0>pp){pp=a[1]+0;pc=b[1]+0}}
                    if($i~/^ct=/){split($i,a,"/");gsub(/ct=/,"",a[1]);split(a[2],b,"(")
                        if(a[1]+0>cp){cp=a[1]+0;cc=b[1]+0}}
                    if($i~/^cd_fifo=/){split($i,a,"/");gsub(/cd_fifo=/,"",a[1]);split(a[2],b,"(")
                        if(a[1]+0>dp){dp=a[1]+0;dc=b[1]+0}}
                    if($i~/^pf_queue_peak=/){split($i,a,"=");if(a[2]+0>qp)qp=a[2]+0}}
            } END {printf "prb=%d/%d(%.1f%%) ct=%d/%d(%.1f%%) cd_fifo=%d/%d(%.1f%%) pf_queue_peak=%d",
                pp,pc,(pc>0?100.0*pp/pc:0),cp,cc,(cc>0?100.0*cp/cc:0),dp,dc,(dc>0?100.0*dp/dc:0),qp}')

            # GRASP_RFAIL: recover absolute counts from percentages, sum across all SMs, then recompute the percentage
            grasp_rfail=$(grep "^GRASP_RFAIL SM" "$log_file" | awk '{
                split($2,a,":"); gsub(/SM/,"",a[1]); sm=a[1]
                for(i=3;i<=NF;i++){split($i,kv,"=")
                    if(kv[1]=="total")tot[sm]=kv[2]+0}
                if(tot[sm]>0){
                    for(i=3;i<=NF;i++){split($i,kv,"=");gsub(/%/,"",kv[2])
                        if(kv[1]=="line_alloc")la[sm]=int(kv[2]*tot[sm]/100+0.5)
                        if(kv[1]=="missq")mq[sm]=int(kv[2]*tot[sm]/100+0.5)
                        if(kv[1]=="mshr_entry")me[sm]=int(kv[2]*tot[sm]/100+0.5)
                        if(kv[1]=="mshr_merge")mm[sm]=int(kv[2]*tot[sm]/100+0.5)
                        if(kv[1]=="rw_pending")rw[sm]=int(kv[2]*tot[sm]/100+0.5)}
                }
            } END {tt=0;tla=0;tmq=0;tme=0;tmm=0;trw=0
                for(s in tot){tt+=tot[s];tla+=la[s];tmq+=mq[s];tme+=me[s];tmm+=mm[s];trw+=rw[s]}
                printf "total=%d",tt
                if(tt>0)printf " line_alloc=%.1f%% missq=%.1f%% mshr_entry=%.1f%% mshr_merge=%.1f%% rw_pending=%.1f%%",
                    100.0*tla/tt,100.0*tmq/tt,100.0*tme/tt,100.0*tmm/tt,100.0*trw/tt}')

            # GRASP_FUNNEL: absolute counts summed across all SMs
            grasp_funnel=$(grep "^GRASP_FUNNEL SM" "$log_file" | awk '{
                split($2,a,":"); gsub(/SM/,"",a[1]); sm=a[1]
                for(i=3;i<=NF;i++){
                    n=$i; gsub(/\(.*\)/,"",n); split(n,kv,"=")
                    if(kv[1]=="idx_attempted")ia[sm]=kv[2]+0
                    if(kv[1]=="idx_rfail")irf[sm]=kv[2]+0
                    if(kv[1]=="idx_got_data")igd[sm]=kv[2]+0
                    if(kv[1]=="data_enqueued")de[sm]=kv[2]+0
                    if(kv[1]=="data_throttled")dt[sm]=kv[2]+0
                    if(kv[1]=="data_attempted")da[sm]=kv[2]+0
                    if(kv[1]=="data_rfail")drf[sm]=kv[2]+0
                    if(kv[1]=="data_got_data")dgd[sm]=kv[2]+0}
            } END {tia=0;tirf=0;tigd=0;tde=0;tdt=0;tda=0;tdrf=0;tdgd=0
                for(s in ia){tia+=ia[s];tirf+=irf[s];tigd+=igd[s];tde+=de[s];tdt+=dt[s];tda+=da[s];tdrf+=drf[s];tdgd+=dgd[s]}
                printf "idx_attempted=%d idx_rfail=%d",tia,tirf
                if(tia>0)printf "(%.1f%%)",100.0*tirf/tia
                printf " idx_got_data=%d | data_enqueued=%d data_throttled=%d data_attempted=%d data_rfail=%d",tigd,tde,tdt,tda,tdrf
                if(tda>0)printf "(%.1f%%)",100.0*tdrf/tda
                printf " data_got_data=%d",tdgd}')

            # GRASP_BOTTLENECK: theoretical vs actual, absolute counts summed across all SMs
            grasp_bottleneck=$(grep "^GRASP_BOTTLENECK SM" "$log_file" | awk '{
                split($2,a,":"); gsub(/SM/,"",a[1]); sm=a[1]
                for(i=3;i<=NF;i++){
                    if($i=="|") continue
                    split($i,kv,"=")
                    if(kv[1]=="idx_theory")it[sm]=kv[2]+0
                    if(kv[1]=="idx_generated")ig[sm]=kv[2]+0
                    if(kv[1]=="idx_accepted")iac[sm]=kv[2]+0
                    if(kv[1]=="idx_rfail")irf[sm]=kv[2]+0
                    if(kv[1]=="idx_retried")ire[sm]=kv[2]+0
                    if(kv[1]=="data_theory")dt[sm]=kv[2]+0
                    if(kv[1]=="data_enqueued")deq[sm]=kv[2]+0
                    if(kv[1]=="data_accepted")dac[sm]=kv[2]+0
                    if(kv[1]=="data_rfail")drf[sm]=kv[2]+0
                    if(kv[1]=="data_retried")dre[sm]=kv[2]+0
                    if(kv[1]=="tc_suppressed")tcs[sm]=kv[2]+0
                    if(kv[1]=="no_throttle")nt[sm]=kv[2]+0}
            } END {tit=0;tig=0;tiac=0;tirf=0;tire=0;tdt=0;tdeq=0;tdac=0;tdrf=0;tdre=0;ttcs=0;tnt=0
                for(s in it){tit+=it[s];tig+=ig[s];tiac+=iac[s];tirf+=irf[s];tire+=ire[s];
                             tdt+=dt[s];tdeq+=deq[s];tdac+=dac[s];tdrf+=drf[s];tdre+=dre[s];
                             ttcs+=tcs[s];tnt=nt[s]}
                printf "idx_theory=%d idx_generated=%d idx_accepted=%d",tit,tig,tiac
                if(tit>0)printf "(%.1f%%)",100.0*tiac/tit
                printf " idx_rfail=%d idx_retried=%d | data_theory=%d data_enqueued=%d data_accepted=%d",tirf,tire,tdt,tdeq,tdac
                if(tdt>0)printf "(%.1f%%)",100.0*tdac/tdt
                printf " data_rfail=%d data_retried=%d | tc_suppressed=%d no_throttle=%d",tdrf,tdre,ttcs,tnt}')

            # 8. Compute coverage = 1 - grasp_data_misses / baseline_data_misses
            local registry="$BASE_DIR/result/baseline_registry.csv"
            if [ -f "$registry" ] && [ -n "$grasp_ima_misses" ]; then
                local baseline_ima_misses
                baseline_ima_misses=$(grep "^${TRACE_KEY},${CONFIG_MODEL}," "$registry" | head -1 | cut -d, -f6)
                if [ -n "$baseline_ima_misses" ] && [ "$baseline_ima_misses" -gt 0 ] 2>/dev/null; then
                    coverage_str=$(awk -v g="$grasp_ima_misses" -v b="$baseline_ima_misses" \
                        'BEGIN { printf "%.2f%%", (1 - g/b) * 100 }')
                fi
            fi
        fi

        # 7. Write EXPERIMENT SUMMARY to the end of the log
        {
            echo ""
            echo "=== EXPERIMENT SUMMARY ==="
            echo "trace_key=$TRACE_KEY"
            echo "config=$CONFIG_MODEL"
            echo "grasp_enabled=$GRASP_ENABLED"
            echo "expected_kernels=$expected_kernels"
            echo "completed_kernels=$completed_kernels"
            echo "final_ipc=$final_ipc"
            echo "final_cycles=$final_cycles"
            echo "status=$status"
            if [ -n "$ima_demand_line" ]; then
                echo "ima_demand: $ima_demand_line"
            fi
            if [ -n "$grasp_effect" ]; then
                echo "--- GRASP Metrics (All SMs) ---"
                echo "effect: $grasp_effect"
                echo "storage(max): $grasp_storage"
                echo "rfail: $grasp_rfail"
                echo "funnel: $grasp_funnel"
                if [ -n "$grasp_bottleneck" ]; then
                    echo "bottleneck: $grasp_bottleneck"
                fi
                if [ -n "$ima_timeliness_line" ]; then
                    echo "timeliness: $ima_timeliness_line"
                fi
                if [ -n "$coverage_str" ]; then
                    echo "coverage=$coverage_str (1 - grasp_data_misses/baseline_data_misses)"
                fi
            fi
            echo "=== END SUMMARY ==="
        } >> "$log_file"

        # Print the summary to the terminal
        echo ""
        echo "── Experiment completeness verification ──"
        echo "  Expected kernels: $expected_kernels"
        echo "  Completed kernels: $completed_kernels"
        echo "  Final IPC: $final_ipc"
        echo "  Final cycles: $final_cycles"
        echo "  Status: $status"
        if [ "$GRASP_ENABLED" = true ] && [ -n "$grasp_effect" ]; then
            echo "  ── GRASP Metrics (All SMs) ──"
            echo "  $grasp_effect"
            echo "  storage(max): $grasp_storage"
            echo "  rfail: $grasp_rfail"
            echo "  funnel: $grasp_funnel"
            if [ -n "$grasp_bottleneck" ]; then
                echo "  bottleneck: $grasp_bottleneck"
            fi
            if [ -n "$ima_timeliness_line" ]; then
                echo "  timeliness: $ima_timeliness_line"
            fi
            if [ -n "$coverage_str" ]; then
                echo "  coverage: $coverage_str"
            fi
        fi
        if [ "$status" != "COMPLETE" ]; then
            echo "  ⚠ The experiment did not complete fully! The results may be inaccurate."
        fi
        echo "────────────────────"
    }

    verify_completion "$LOG_FILE" "$TRACE_PATH"

    # ── Baseline Registry auto-update ─────────────────────────────────
    update_baseline_registry() {
        local log_file="$1"
        local registry="$BASE_DIR/result/baseline_registry.csv"

        # Only write when not in GRASP mode (baseline)
        if [ "$GRASP_ENABLED" = true ]; then return; fi

        # Extract data from EXPERIMENT SUMMARY
        local status
        status=$(grep "^status=" "$log_file" | tail -1 | cut -d= -f2)

        # Only write to the registry when status is COMPLETE
        if [ "$status" != "COMPLETE" ]; then
            echo "[baseline-registry] Experiment not complete (status=$status), skipping write"
            return
        fi

        local final_ipc completed_kernels final_cycles
        final_ipc=$(grep "^final_ipc=" "$log_file" | tail -1 | cut -d= -f2)
        completed_kernels=$(grep "^completed_kernels=" "$log_file" | tail -1 | cut -d= -f2)
        final_cycles=$(grep "^final_cycles=" "$log_file" | tail -1 | cut -d= -f2)

        # Extract IMA demand misses (from the IMA_DEMAND: line)
        local ima_misses
        ima_misses=$(grep "^IMA_DEMAND:" "$log_file" | tail -1 | grep -oP 'total_misses=\K[0-9]+' || echo "0")

        local git_commit
        git_commit=$(git -C "$BASE_DIR" rev-parse --short HEAD 2>/dev/null || echo "unknown")
        local today
        today=$(date +%F)

        # Create the header (first time only)
        if [ ! -f "$registry" ]; then
            echo "trace_key,config,kernels,final_ipc,final_cycles,ima_misses,log_file,git_commit,date" > "$registry"
        fi

        # Remove the old entry with the same trace_key+config, then write the new entry
        local tmp_reg="${registry}.tmp"
        head -1 "$registry" > "$tmp_reg"
        tail -n +2 "$registry" | grep -v "^${TRACE_KEY},${CONFIG_MODEL}," >> "$tmp_reg" 2>/dev/null || true
        echo "${TRACE_KEY},${CONFIG_MODEL},${completed_kernels},${final_ipc},${final_cycles},${ima_misses},$(basename "$log_file"),${git_commit},${today}" >> "$tmp_reg"
        mv "$tmp_reg" "$registry"

        echo "[baseline-registry] Updated: ${TRACE_KEY} (IPC=${final_ipc}, ima_misses=${ima_misses})"
    }

    update_baseline_registry "$LOG_FILE"

    echo ""
    echo "=========================================="
    echo "Simulation complete!"
    echo "Results saved to:"
    echo "  Log: $LOG_FILE"
    echo "  CSV: $CSV_FILE"
    echo "  L2 CSV: $L2_CSV_FILE"
    if [ "$ISSUE_TRACE_ENABLED" = true ]; then
        echo "  Issue trace: $ISSUE_FILE"
    else
        echo "  Issue trace: (disabled)"
    fi
    if [ "$STALL_REASON_PC_STATS_ENABLED" = true ]; then
        echo "  Stall reason/PC stats dir: $RESULT_STALL_REASON_PC_STATS_DIR"
        echo "    - $STALL_REASON_PC_STATS_BREAKDOWN"
        echo "    - $STALL_REASON_PC_STATS_HIST"
        if [ "${STALL_REASON_PC_STATS_TOPK:-0}" != "0" ]; then
            echo "    - $STALL_REASON_PC_STATS_TOPK_FILE"
        fi
    else
        echo "  Stall reason/PC stats: (disabled)"
    fi
    echo "  HBM partition bandwidth CSV: $BANDWIDTH_FILE"
    if [ "$ICNT_BW_TRACE_ENABLED" = true ]; then
        echo "  ICNT bandwidth CSV: $ICNT_BW_FILE"
    fi
    if [ "$L2_BW_TRACE_ENABLED" = true ]; then
        echo "  L2 bandwidth CSV: $L2_BW_FILE"
    fi
    echo "=========================================="

    if [ "$PLOT_ENABLED" = true ]; then
        PLOT_SCRIPT="$BASE_DIR/result/plot/run_plots.sh"
        if [ ! -x "$PLOT_SCRIPT" ]; then
            echo "[warn] Plot script not found or not executable: $PLOT_SCRIPT"
        else
            echo ""
            echo "=========================================="
            echo "Starting plotting..."
            echo "=========================================="
            PLOT_ARGS=(--log-name "$LOG_NAME" --format "$PLOT_FORMAT" --backend "$PLOT_BACKEND")
            if [ "$PLOT_BACKEND" = "local" ]; then
                if [ "$PLOT_BACKGROUND" = true ]; then
                    PLOT_ARGS+=(--background)
                fi
            else
                if [ -n "$PLOT_SESSION" ]; then
                    PLOT_ARGS+=(--session "$PLOT_SESSION")
                fi
                if [ "$PLOT_KILL_EXISTING" = true ]; then
                    PLOT_ARGS+=(--kill-existing)
                fi
                if [ "$PLOT_ATTACH" = true ]; then
                    PLOT_ARGS+=(--attach)
                fi
                if [ "$PLOT_TMUX_AUTO_CLOSE" = true ]; then
                    PLOT_ARGS+=(--auto-close)
                fi
                if [ "$PLOT_TMUX_MONITOR" = true ]; then
                    PLOT_ARGS+=(--monitor)
                fi
            fi

            if ! "$PLOT_SCRIPT" "${PLOT_ARGS[@]}"; then
                echo "[warn] Failed to start plotting (does not affect the simulation results). Please run manually:"
                echo "  $PLOT_SCRIPT --log-name $LOG_NAME --format $PLOT_FORMAT --backend $PLOT_BACKEND"
            fi
        fi
    fi
else
    echo ""
    echo "=========================================="
    echo "Simulation run failed, please check the log file: $LOG_FILE"
    echo "=========================================="
    exit 1
fi
